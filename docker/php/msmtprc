# Default: relay mail to the Postfix running on the Docker host.
# Requires the host MTA to accept connections from the docker bridge:
# on the host, inet_interfaces must listen beyond loopback and
# mynetworks must include the docker subnet (e.g. 172.16.0.0/12).
# Override by mounting a custom file over /etc/msmtprc
# (see the commented mount in docker-compose.yml).
account default
host host.docker.internal
port 25
tls off
