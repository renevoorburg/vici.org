# Environment for the preview stack (docker-compose.yml).
# Copy to .env.preview and fill in the real values.
# .env.preview is gitignored — never commit real credentials.
#
# Double duty: the file is mounted into the php container as .env for
# the app AND, when compose is invoked with --env-file .env.preview,
# supplies the ${…} variables used inside the compose file itself
# (PROD_STATIC_DIR, PROD_UPLOADS_DIR, PORT below). Recommended:
#   docker compose --env-file .env.preview ...

# --- Compose-level variables (need --env-file .env.preview) ---

# Name of this env file: used for compose interpolation AND mounted into
# the php container as the app's .env. For a production env file, copy
# this file to e.g. .env.production, set ENV_FILE=.env.production and
# VICIBASE=https://vici.org, then start with --env-file .env.production.
ENV_FILE=.env.preview

# Host dir that contains uploads/, livius/ etc.; mounted read-only at
# /srv/static for the S3 migration (bin/sync-images-to-s3.php).
PROD_STATIC_DIR=/var/www/org.vici.static/public

# Host dir bind-mounted as public/uploads — only used in local-storage
# mode (no S3_BUCKET). Should be <PROD_STATIC_DIR>/uploads.
PROD_UPLOADS_DIR=/var/www/org.vici.static/public/uploads

# Host port the web container publishes on (127.0.0.1 only; the host
# nginx proxies the vhost to this port).
PORT=8081

# --- Database: choose one of two modes ---

# Mode a) production database on the host.
# host.docker.internal resolves to the docker bridge gateway (extra_hosts
# in docker-compose.yml); this requires mysqld to also listen on
# the bridge interface — a bind-address of 127.0.0.1 only will NOT work.
# Either widen bind-address (e.g. 0.0.0.0 or the docker0 address) or set
# DB_HOST to an address MySQL listens on.
DB_HOST=host.docker.internal
DB_MAIN=vici
DB_GEO=geo
DB_USER=vici
DB_PASS=changeme

# Mode b) containerized database with a fresh dump.
# Start the stack with --profile localdb and place .sql/.sql.gz files in
# ./db-preview/ first. Credentials must match the mysql service env in
# docker-compose.yml (defaults: vici / vici).
# DB_HOST=mysql
# DB_MAIN=vici
# DB_GEO=geo
# DB_USER=vici
# DB_PASS=vici

VICIBASE=https://preview.vici.org
VICITOKEN=
EXTSECRET=

# Envelope/header sender for account-activation mails.
MAIL_FROM=noreply@vici.org

# --- S3-compatible object storage for uploaded images (TransIP Object Store) ---
# When S3_BUCKET is set, uploads go to object storage instead of
# public/uploads. Objects are stored with the "uploads/" prefix so keys
# match the img_path values in the database.
S3_ENDPOINT=https://<project-id>.objectstore.eu
S3_REGION=EU
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# S3_PREFIX defaults to "uploads" — keep in sync with img_path.
# All image URLs in the HTML go through images.vici.org; the image
# proxy resolves the paths, so no public-base URL is needed here.

# Real Cloudflare Turnstile keys — the dev test keys must not be used here.
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
