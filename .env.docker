# Environment for the Docker development stack (mounted as .env in the
# php container). Placeholder/development values only — real secrets live
# in the production environment.

DB_HOST=mysql
DB_MAIN=vici
DB_GEO=geo
DB_USER=vici
DB_PASS=vici

VICIBASE=http://localhost:8080
VICITOKEN=dev-token
EXTSECRET=dev-secret

# ALTCHA HMAC key — signs the captcha challenges served at /captcha.
ALTCHA_HMAC_KEY=835ae651049c26894033614de7b8cba4ae32a2c551309135b4b754aacb4c77d1

# recipient of the public /contact form (falls back to MAIL_FROM)
MAIL_CONTACT=noreply@vici.org
MAIL_FROM=noreply@vici.org
