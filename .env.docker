# Docker environment variables
DB_HOST=mysql
DB_MAIN=vici
DB_GEO=geo
DB_USER=vici
DB_PASS=vici
VICIBASE=http://localhost
VICITOKEN=your-secret-token
EXTSECRET=your-ext-secret

# Port configuration
NGINX_PORT=80
DB_PORT=3306

# MariaDB environment variables
MYSQL_DATABASE=vici
MYSQL_USER=vici
MYSQL_PASSWORD=vici
MYSQL_ROOT_PASSWORD=rootpassword

# Optional: custom API tokens and user-agent prefixes (CUST1-9, UA1-9)
# CUST1=extra-token-1
# UA1=MyCustomApp/
