# Environment for the Docker development stack (mounted as .env in the
# php container). Placeholder/development values only — real secrets live
# in the production environment.

DB_HOST=mysql
DB_MAIN=vici
DB_GEO=geo
DB_USER=vici
DB_PASS=vici

VICIBASE=http://localhost:8080
VICITOKEN=dev-token
EXTSECRET=dev-secret

# Cloudflare Turnstile test keys — always pass verification in development.
# See https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=1x00000000000000000000AA
