# Production environment variables
# Copy this to .env.prod and update with production values

# Database configuration
DB_HOST=mysql
DB_MAIN=vici
DB_GEO=geo
DB_USER=viciuser
DB_PASS=CHANGE_THIS_STRONG_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_THIS_ROOT_PASSWORD

# Application configuration
VICIBASE=https://vici.org
VICITOKEN=CHANGE_THIS_API_TOKEN
EXTSECRET=CHANGE_THIS_EXTERNAL_SECRET

# Port configuration
NGINX_PORT=8080
DB_PORT=3306

# Optional: custom API tokens and user-agent prefixes (CUST1-9, UA1-9)
# CUST1=extra-token-1
# UA1=MyCustomApp/
